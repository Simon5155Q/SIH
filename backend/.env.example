JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
APP_ENV=development

# Gmail SMTP. Leave blank in development to print OTPs in the backend console.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Certificate HMAC signing
CERTIFICATE_HMAC_SECRET=replace-with-a-separate-random-secret
