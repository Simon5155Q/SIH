# --- Application ---
APP_NAME="Legal Metrology Verification System"
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=true

# --- Database ---
# Local demo uses SQLite for zero-setup development. Update to PostgreSQL in production.
DATABASE_URL=sqlite+aiosqlite:///./legal_metrology.db
DATABASE_URL_SYNC=sqlite:///./legal_metrology.db

# --- JWT / Security ---
JWT_SECRET_KEY=change-this-to-a-long-random-value-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Certificate Anti-Tamper Signing ---
CERTIFICATE_HMAC_SECRET=change-this-to-a-separate-long-random-value

# --- Optional Gmail SMTP OTP delivery ---
# Leave blank in development to log OTPs to the backend console.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- File Storage ---
STORAGE_BACKEND=local   # local | s3
LOCAL_STORAGE_PATH=./storage
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Rate Limiting ---
RATE_LIMIT_AUTH="5/minute"
RATE_LIMIT_PUBLIC_VERIFY="20/minute"
